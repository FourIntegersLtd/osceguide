# The unified backend. Nothing else is called.
NEXT_PUBLIC_PLATFORM_API_URL=http://127.0.0.1:8002

# This deployment's own public origin. Left unset here (and in production),
# which defaults to "https://osceguide.com" — see
# src/foundation/config/siteUrl.ts, the one place that reads this variable.
#
# Staging and Vercel previews build with NODE_ENV=production too, so nothing
# in this app may use NODE_ENV to tell them apart from the real production
# site. This variable is what actually does: set it on staging so robots,
# the document head, the exam-subdomain resolver and analytics all know they
# are not production.
#
#   staging:    NEXT_PUBLIC_SITE_URL=https://staging.osceguide.com
#   production: leave unset
# NEXT_PUBLIC_SITE_URL=https://staging.osceguide.com

# Google Analytics. Unset here (and in production) falls back to
# production's own GA property, but only when NEXT_PUBLIC_SITE_URL above is
# production's — staging and previews must set this to an empty string so
# they never phone production's analytics with a developer's or a tester's
# clicks:
#
#   staging and previews: NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# The backend this deployment talks to server-side (distinct from the
# NEXT_PUBLIC_ variable above, which is what the browser calls). Staging
# points at its own backend, never production's:
#
#   staging: PLATFORM_API_URL=https://staging-api.osceguide.com
# PLATFORM_API_URL=https://staging-api.osceguide.com

# Error reporting (Sentry). Off when unset, as in platform-api. The browser
# reads the NEXT_PUBLIC_ DSN, inlined at build time; the server may use its own.
# Staging and previews set the environment name explicitly.
#
#   NEXT_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
#   NEXT_PUBLIC_SENTRY_ENVIRONMENT=staging
#   SENTRY_DSN=
#
# Build-time only, for readable stack traces (source map upload):
#   SENTRY_AUTH_TOKEN=  SENTRY_ORG=  SENTRY_PROJECT=
