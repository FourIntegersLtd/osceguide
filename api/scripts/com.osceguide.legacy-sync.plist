<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs the legacy sync every night at 03:00 on this Mac. A Mac that is asleep at 03:00 runs it when it
  wakes. Install:
    cp scripts/com.osceguide.legacy-sync.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.osceguide.legacy-sync.plist
  Remove:
    launchctl bootout gui/$(id -u) ~/Library/LaunchAgents/com.osceguide.legacy-sync.plist
  Test now:
    launchctl kickstart gui/$(id -u)/com.osceguide.legacy-sync
  Output: ~/Library/Logs/osce-legacy-sync.log
  Runs through /bin/bash on purpose: launchd exec'ing the script directly under ~/Documents exited 126
  (never reached the log) on 2026-11-05 to 2026-11-08. The real cause is macOS privacy: a launchd job has
  no access to ~/Documents until /bin/bash is granted Full Disk Access in System Settings.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.osceguide.legacy-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/yahayakenny/Documents/Projects/osceguide/api/scripts/sync_b2c_nightly.sh</string>
    <string>production</string>
  </array>
  <!-- launchd's own stderr, for failures that happen before the wrapper can write its log. -->
  <key>StandardErrorPath</key>
  <string>/Users/yahayakenny/Library/Logs/osce-legacy-sync.launchd.log</string>
  <key>StandardOutPath</key>
  <string>/Users/yahayakenny/Library/Logs/osce-legacy-sync.launchd.log</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
</dict>
</plist>
