{
  "templates": [
    {
      "exam_code": "sca",
      "title": "SCA consultation station",
      "start_point": "sca",
      "structure": {
        "schemaVersion": 1,
        "layout": {
          "persona": "patient"
        },
        "sections": [
          {
            "id": "patient_information",
            "title": "Patient Information",
            "audience": "patient",
            "blocks": [
              {
                "id": "patient_biodata",
                "type": "shortText",
                "role": "persona",
                "label": "Patient Biodata",
                "required": true,
                "placeholder": "e.g. Aisha Khan, 24, female, university student"
              },
              {
                "id": "gender",
                "type": "singleSelect",
                "role": "persona",
                "label": "Gender",
                "required": true,
                "options": [
                  "male",
                  "female"
                ]
              },
              {
                "id": "persona",
                "type": "longText",
                "role": "persona",
                "label": "Persona",
                "placeholder": "Tone, anxiety level, how they open up. e.g. Nervous at first but cooperative; tearful when discussing family."
              },
              {
                "id": "opening_sentence",
                "type": "longText",
                "role": "complaint",
                "label": "Opening sentence",
                "required": true,
                "placeholder": "First-person line the AI patient says to open (no \u201cHi doctor\u201d). e.g. I'm pregnant\u2026 I need an abortion. If my family finds out, I'm scared they'll kill me."
              },
              {
                "id": "expanded_history",
                "type": "longText",
                "role": "history",
                "label": "Expanded history",
                "required": true,
                "placeholder": "Full history the patient reveals when asked \u2014 not the opening line."
              },
              {
                "id": "past_med_history_allergies",
                "type": "list",
                "role": "history",
                "label": "Past medical history and allergies"
              },
              {
                "id": "family_social_history",
                "type": "list",
                "role": "social",
                "label": "Family and social history"
              },
              {
                "id": "idea",
                "type": "list",
                "role": "hidden",
                "label": "Ideas (ICE)"
              },
              {
                "id": "concerns",
                "type": "list",
                "role": "hidden",
                "label": "Concerns (ICE)"
              },
              {
                "id": "expectation",
                "type": "list",
                "role": "hidden",
                "label": "Expectations (ICE)"
              },
              {
                "id": "questions",
                "type": "list",
                "role": "hidden",
                "label": "Questions the patient may ask"
              }
            ]
          },
          {
            "id": "doctor_information",
            "title": "Doctor Information",
            "audience": "candidate",
            "blocks": [
              {
                "id": "doctor_patient_biodata",
                "type": "longText",
                "role": "candidate_brief",
                "label": "Patient Biodata",
                "placeholder": "e.g. John Doe, 35"
              },
              {
                "id": "recent_notes",
                "type": "list",
                "role": "candidate_brief",
                "label": "Recent Notes",
                "placeholder": "Past GP visits only \u2014 not today's story. e.g. No recent GP visits; or Seen 2 months ago for medication review."
              },
              {
                "id": "current_medications",
                "type": "list",
                "role": "candidate_brief",
                "label": "Current Medications"
              },
              {
                "id": "past_medical_history",
                "type": "list",
                "role": "candidate_brief",
                "label": "Past Medical History"
              },
              {
                "id": "recent_investigations",
                "type": "list",
                "role": "candidate_brief",
                "label": "Recent Investigations"
              },
              {
                "id": "social_history",
                "type": "list",
                "role": "candidate_brief",
                "label": "Social History"
              },
              {
                "id": "doctor_photos",
                "type": "media",
                "role": "candidate_brief",
                "label": "Photos"
              }
            ]
          },
          {
            "id": "management_plan",
            "title": "Management Plan",
            "audience": "examiner",
            "blocks": [
              {
                "id": "explanation",
                "type": "longText",
                "role": "examiner",
                "label": "Explanation"
              },
              {
                "id": "assessment",
                "type": "list",
                "role": "examiner",
                "label": "Assessment"
              },
              {
                "id": "social_concerns",
                "type": "list",
                "role": "examiner",
                "label": "Social Concerns"
              },
              {
                "id": "ice",
                "type": "list",
                "role": "examiner",
                "label": "ICE"
              },
              {
                "id": "immediate_actions",
                "type": "list",
                "role": "examiner",
                "label": "Immediate Actions"
              },
              {
                "id": "pharmacological_treatment",
                "type": "list",
                "role": "examiner",
                "label": "Pharmacological Treatment"
              },
              {
                "id": "non_pharmacological_treatment",
                "type": "list",
                "role": "examiner",
                "label": "Non-Pharmacological Treatment"
              },
              {
                "id": "follow_up",
                "type": "longText",
                "role": "examiner",
                "label": "Follow Up"
              },
              {
                "id": "health_education",
                "type": "list",
                "role": "examiner",
                "label": "Health Education"
              },
              {
                "id": "safety_netting",
                "type": "longText",
                "role": "examiner",
                "label": "Safety Netting"
              },
              {
                "id": "additional_notes",
                "type": "longText",
                "role": "examiner",
                "label": "Additional Notes"
              }
            ]
          },
          {
            "id": "clinical_experience_groups",
            "title": "Clinical Experience Groups",
            "audience": "examiner",
            "blocks": [
              {
                "id": "capability",
                "type": "singleSelect",
                "role": "examiner",
                "label": "Clinical Experience Groups",
                "options": [
                  "Infants, children and young people (under the age of 19)",
                  "Mental health (including addiction, alcohol and substance misuse)",
                  "People with long term conditions including cancer, multi-morbidity and disability",
                  "Older adults including frailty and/or people at end of life",
                  "Gender, reproductive and sexual health (including women's, men's, LGBTQ, gynaecology and breast)",
                  "Urgent and unscheduled care",
                  "People with health disadvantage and vulnerabilities (including veterans, mental capacity difficulties, safeguarding and those with communication difficulties/disability)",
                  "Population Health and health promotion (including people with non-acute and/or non-chronic health problems)",
                  "Clinical problems not linked to a specific clinical experience group",
                  "Ethnicity, culture, diversity, inclusivity",
                  "New presentation of undifferentiated disease",
                  "Prescribing",
                  "Investigation / Results",
                  "Professional conversation / Professional dilemma"
                ]
              }
            ]
          }
        ],
        "generation": {
          "profileKey": "sca.station"
        }
      }
    },
