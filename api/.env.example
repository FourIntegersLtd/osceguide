# OSCE Guide Platform API — local development values.
# Copy to .env. Deployed environments set these in the host's own
# configuration; `docs/ENVIRONMENT.md` is the full reference and explains what
# breaks without each one.

APP_ENV=local

# --- Required in staging and production -------------------------------------
# The process refuses to start without every name in this section. That is
# deliberate: a missing WORKER_SECRET would otherwise become an unauthenticated
# worker route, and a missing CORS_ORIGINS once accepted credentialed requests
# from localhost.
# Locally they have development defaults that could not be mistaken for real
# ones, so only the first few matter to run the app on this machine.

# docker compose exposes Postgres on 5433 and Redis on 6380 so they do not
# collide with anything already running. The image is pgvector/pgvector:pg16 —
# the tutor's material index is a `vector` column, and a stock Postgres fails
# at `alembic upgrade head`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/osce_platform

JWT_SECRET=dev-only-jwt-secret-change-me

# Same value on this API and in the assessment-platform worker's environment
# for the "platform" backend label (its VOICE_BACKENDS_JSON entry reads
# PLATFORM_WORKER_SECRET).
WORKER_SECRET=dev-only-worker-secret

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100

# The SFU is always LiveKit Cloud; only the agent workers are self-hosted.
# Without a URL, `voice-token` refuses rather than issuing a token that goes
# nowhere.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# When sharing a LiveKit project with deployed workers, give local workers
# a unique prefix and register both families with the matching names.
# Example: dev-alice-assessment-self-hosted / dev-alice-assistant-self-hosted.
LIVEKIT_AGENT_NAMESPACE=

# Per endpoint. Without it webhooks are refused rather than trusted, which
# loses purchases rather than granting them falsely.
STRIPE_WEBHOOK_SECRET=

# Encrypts a referrer's bank details at rest (sort code, account number) for
# payout settlement. Generate one with:
#   poetry run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAYOUT_DETAILS_KEY=

# Encrypts a TOTP shared secret at rest. A different key from PAYOUT_DETAILS_KEY.
# Generate one with the same Fernet one-liner. Local and test fill a fixed
# development value when this is empty.
MFA_SECRET_KEY=

# The only email configuration there is.
RESEND_API_KEY=

# Marking, the tutor's summaries and the material index embeddings.
OPENAI_API_KEY=

# --- Optional ---------------------------------------------------------------
REDIS_URL=redis://localhost:6380/0
# platform-web, not the retiring client on :3000. Stripe sends a paying
# customer back to `{FRONTEND_URL}/billing/complete`, so pointing this at the
# old app lands them on its 404 with their money already taken.
FRONTEND_URL=http://localhost:3100
# Where a peer-practice abuse or no-show report is emailed.
SUPPORT_EMAIL=support@osceguide.com
# Object storage for station images and generated audio/video. Without a
# bucket the station photo routes refuse rather than the process failing to
# start — an orthopaedic station is a radiograph, so authoring one needs this.
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
LOG_LEVEL=INFO

# Fallback marking. Not required: without it, marking has no second chance.
ANTHROPIC_API_KEY=

# Checkout. Not one of the required ten, so a deployment can boot without
# being able to sell.
STRIPE_SECRET_KEY=

# Partner reconciliation (G-1). Optional: without them the reconciliation
# report says Mixpanel is unconfigured and the ledger count stands alone.
MIXPANEL_API_SECRET=
MIXPANEL_QUERY_API_ENABLED=false

# Partner SSO, brokered through Clerk. Not one of the required ten: a
# deployment without them cannot offer SSO, and the login/callback routes
# refuse rather than trust an unverified token. Each organisation's Clerk
# frontend domain is stored on its own SSO configuration (`issuer`).
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# The legacy login bridge, deleted at decommission. These verify tokens the
# retiring backends issued so an existing user need not reset a password; they
# are read only to check a signature. Leaving one empty disables that arm's
# exchange rather than trusting anything. Set them to the live
# JWT_SECRET_KEY (b2c-api) and JWT_SECRET (b2b-api).
LEGACY_CONSUMER_JWT_SECRET=
LEGACY_INSTITUTION_JWT_SECRET=

# Error reporting.
SENTRY_DSN=

# This API's public address, for SAML service-provider metadata and the
# assertion consumer URL an institution's IdP posts to (E-20).
PUBLIC_API_URL=http://localhost:8002
