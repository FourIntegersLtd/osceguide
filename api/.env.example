# OSCE Guide Platform API — local development values.
# Copy to .env. Deployed environments set these in the host's own
# configuration; `docs/ENVIRONMENT.md` is the full reference and explains what
# breaks without each one.

APP_ENV=local

# --- Required in staging and production -------------------------------------
# The process refuses to start without all ten. That is deliberate: a missing
# WORKER_SECRET would otherwise become an unauthenticated worker route, and a
# missing CORS_ORIGINS once accepted credentialed requests from localhost.
# Locally they have development defaults that could not be mistaken for real
# ones, so only the first few matter to run the app on this machine.

# docker compose exposes Postgres on 5433 and Redis on 6380 so they do not
# collide with anything already running. The image is pgvector/pgvector:pg16 —
# the tutor's material index is a `vector` column, and a stock Postgres fails
# at `alembic upgrade head`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/osce_platform

JWT_SECRET=dev-only-jwt-secret-change-me

# Same value on this API and in the assessment-platform worker's environment
# for the "platform" backend label (its VOICE_BACKENDS_JSON entry reads
# PLATFORM_WORKER_SECRET).
WORKER_SECRET=dev-only-worker-secret

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# The SFU is always LiveKit Cloud; only the agent workers are self-hosted.
# Without a URL, `voice-token` refuses rather than issuing a token that goes
# nowhere.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Per endpoint. Without it webhooks are refused rather than trusted, which
# loses purchases rather than granting them falsely.
STRIPE_WEBHOOK_SECRET=

# The only email configuration there is.
RESEND_API_KEY=

# Marking, the tutor's summaries and the material index embeddings.
OPENAI_API_KEY=

# --- Optional ---------------------------------------------------------------
REDIS_URL=redis://localhost:6380/0
# platform-web, not the retiring client on :3000. Stripe sends a paying
# customer back to `{FRONTEND_URL}/billing/complete`, so pointing this at the
# old app lands them on its 404 with their money already taken.
FRONTEND_URL=http://localhost:3100
LOG_LEVEL=INFO

# Fallback marking. Not required: without it, marking has no second chance.
ANTHROPIC_API_KEY=

# Checkout. Not one of the required ten, so a deployment can boot without
# being able to sell.
STRIPE_SECRET_KEY=

# The legacy login bridge, deleted at decommission. These verify tokens the
# retiring backends issued so an existing user need not reset a password; they
# are read only to check a signature. Leaving one empty disables that arm's
# exchange rather than trusting anything. Set them to the live
# JWT_SECRET_KEY (b2c-api) and JWT_SECRET (b2b-api).
LEGACY_CONSUMER_JWT_SECRET=
LEGACY_INSTITUTION_JWT_SECRET=

# Error reporting.
SENTRY_DSN=
