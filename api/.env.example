# OSCE Guide Platform API — local development values.
# Copy to .env. Deployed environments set these in Railway; staging/production
# refuse to start if JWT_SECRET, WORKER_SECRET or DATABASE_URL are missing.

APP_ENV=local

# docker compose exposes Postgres on 5433 and Redis on 6380 so they do not
# collide with anything already running locally.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/osce_platform
REDIS_URL=redis://localhost:6380/0

JWT_SECRET=dev-only-jwt-secret-change-me

# Same value on this API and in the assessment-platform worker's env for the
# "platform" backend label (VOICE_BACKENDS_JSON).
WORKER_SECRET=dev-only-worker-secret

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO
