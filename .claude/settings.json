{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "autoCompactWindow": 200000,
  "autoCompactEnabled": true,
  "effortLevel": "medium",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/quality-gate.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/quality-gate.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/cost-guard.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(poetry env *)",
      "Bash(poetry run *)",
      "Bash(poetry install *)",
      "Bash(poetry install)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git log)",
      "Bash(git -C * status *)",
      "Bash(git -C * status)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(ls *)",
      "Bash(ls)",
      "Bash(find *)",
      "Bash(cat *)",
      "Bash(sed -n *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(stat *)",
      "Bash(python3 -)",
      "Bash(python3 - *)",
      "Skill(update-config)",
      "Skill(update-config:*)",
      "Bash(node --test src/b2c/lib/partnerAttribution/parseReferralParams.test.ts)",
      "Bash(lk agent deploy:*)",
      "Bash(lk agent status:*)",
      "Bash(lk agent logs:*)",
      "Bash(lk agent versions:*)",
      "Bash(railway variables:*)",
      "Bash(cd /Users/yahayakenny/Documents/Projects/osceguide*)"
    ]
  }
}
