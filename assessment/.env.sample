# assessment-platform workers — copy to .env for local dev.

# --- Hosting ---
# OSCE_LIVEKIT_HOSTING=self-hosted   # self-hosted | cloud (cloud selects LiveKit Inference turn detection)
OSCE_LIVEKIT_WORKER=assessment        # which worker this process runs (assessment | assistant)
# PORT=8080                           # gunicorn /health; Railway sets PORT

# --- LiveKit project (required; do not put these in LiveKit Cloud secrets) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Agent dispatch names (must match what the backends dispatch to) ---
LIVEKIT_ASSESSMENT_AGENT_NAME=assessment-self-hosted
# LIVEKIT_ASSESSMENT_WORKER_PORT=8087
# LIVEKIT_ASSESSMENT_MAX_CONCURRENT_JOBS=
# LIVEKIT_ASSESSMENT_LOAD_THRESHOLD=
LIVEKIT_ASSISTANT_AGENT_NAME=assistant-self-hosted
# LIVEKIT_ASSISTANT_WORKER_PORT=8088
# LIVEKIT_ASSISTANT_MAX_CONCURRENT_JOBS=
# LIVEKIT_ASSISTANT_LOAD_THRESHOLD=

# --- Assistant worker: on-screen guidance (help sessions) ---
ENABLE_UI_GUIDANCE=true
UI_GUIDANCE_MAX_CALLS_PER_MINUTE=30
UI_GUIDANCE_DISPLAY_WIDTH=1280
UI_GUIDANCE_DISPLAY_HEIGHT=720

# --- Backends the worker serves, by opaque label (job metadata "backend") ---
VOICE_BACKENDS_JSON={"practice":{"base_url_env":"PRACTICE_API_URL","secret_env":"PRACTICE_WORKER_SECRET","secret_header":"X-Worker-Secret","slot_release_path":"/api/worker/livekit-cloud-slot/release","slot_extend_path":"/api/worker/livekit-cloud-slot/extend","slot_payload_key":"room_name"},"institution":{"base_url_env":"INSTITUTION_API_URL","secret_env":"INSTITUTION_WORKER_SECRET","secret_header":"X-B2B-Worker-Secret","slot_release_path":"/api/b2b/worker/livekit-cloud-slot/release","slot_extend_path":"/api/b2b/worker/livekit-cloud-slot/extend","slot_payload_key":"roomName"}}
PRACTICE_API_URL=http://127.0.0.1:5000
PRACTICE_WORKER_SECRET=
INSTITUTION_API_URL=http://127.0.0.1:8001
INSTITUTION_WORKER_SECRET=

# --- AI / voice providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
ELEVEN_API_KEY=
GOOGLE_API_KEY=

# --- Observability ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
